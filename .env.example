# Read-only GitHub token (fine-grained, public repositories, no write scopes). Never commit .env
# Budget lives in configs/runtime.toml. Secrets stay local.
GROQ_API_KEY=
# Optional Jev controller. Enabling also requires separate limits in configs/typesafe.toml.
TYPESAFE_API_KEY=
GITHUB_TOKEN=
# Shared webhook secret; never commit the real value or expose the workbench publicly.
GITHUB_WEBHOOK_SECRET=
# Configure one before installing the App; ID is public metadata, not a token.
GITHUB_APP_ID=
GITHUB_INSTALLATION_ID=
# Optional App-native authentication: install the github-app extra; signing key stays local.
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CLIENT_ID=
